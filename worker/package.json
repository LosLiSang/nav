{
  "name": "nav-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:proxy": "node ../scripts/dev-worker-proxy.mjs",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "token": "wrangler secret put SYNC_TOKEN",
    "db:migrate:local": "wrangler d1 migrations apply nav-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply nav-sync --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "wrangler": "^4.136.2"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "nav": "file:.."
  }
}
